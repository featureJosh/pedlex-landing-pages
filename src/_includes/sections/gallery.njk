{#- Gallery « Réalisations » (white). Data: c.gallery { eyebrow, title, lead, items[{ image, alt, caption }] }.
    Everything visible at once (Raffi, 2026-10-29): the mosaic the client liked on explore/kimi, with a
    title under each photo instead of over it. Phones: one wide photo, then a 2-column grid.
    From 64rem: a 12-column mosaic (one large tile beside two stacked, then two wide).
    Styles: styles/sections/gallery.css -#}
{%- from "components/ui.njk" import sectionHead -%}
<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    {{ sectionHead(c.gallery.eyebrow, c.gallery.title, c.gallery.lead, { id: "gallery-title", index: sectionIndex }) }}
    <ul class="gallery__mosaic section-body" role="list" data-reveal-stagger>
      {%- for item in c.gallery.items %}
      <li class="gallery__tile">
        <figure class="gallery__figure">
          <div class="media gallery__media">
            {% picture item.image, item.alt, ("(min-width: 64rem) 46vw, 92vw" if loop.first else "(min-width: 64rem) 34vw, 46vw") %}
          </div>
          <figcaption class="gallery__caption"><span class="gallery__num" aria-hidden="true">{{ "0" if loop.index < 10 }}{{ loop.index }}</span><span>{{ item.caption | safe }}</span></figcaption>
        </figure>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
