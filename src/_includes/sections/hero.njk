{#- Hero: the page's only <h1>. Message-matches the video ad. Styles: styles/sections/hero.css
    Data: c.hero.{eyebrow, title, lead, text[], trust[], image, imageAlt}, c.ui.{cta, since, phoneLabel},
          c.form.id, site.company.{phone, phoneHref}.
    The image is the LCP element: eager + fetchpriority high, and preloaded in layouts/base.njk
    with the SAME sizes string (keep both in sync). Its slow drift is CSS-only (hero.css). -#}
{%- from "components/ui.njk" import button -%}
<section class="section hero" id="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{{ c.hero.eyebrow | safe }}</p>
      <h1 class="hero__title" id="hero-title">{{ c.hero.title | safe }}</h1>
      <p class="hero__lead">{{ c.hero.lead | safe }}</p>
      <div class="hero__text">
        {%- for p in c.hero.text %}
        <p>{{ p | safe }}</p>
        {%- endfor %}
      </div>
      <div class="hero__actions">
        {{ button(c.ui.cta, "#" + c.form.id, { size: "lg", icon: "arrow-right", class: "hero__cta" }) }}
        <a class="hero__phone" href="tel:{{ site.company.phoneHref }}">
          <span class="hero__phone-icon">{% icon "phone" %}</span>
          <span class="hero__phone-text">
            <span class="hero__phone-label">{{ c.ui.phoneLabel }}</span>
            <span class="hero__phone-number">{{ site.company.phone }}</span>
          </span>
        </a>
      </div>
      <ul class="hero__trust" role="list">
        {%- for item in c.hero.trust %}
        <li class="hero__trust-item">{% icon "circle-check", "hero__trust-icon" %}<span>{{ item | safe }}</span></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="hero__media">
      <div class="media hero__frame">
        {% picture c.hero.image, c.hero.imageAlt | plain, "(min-width: 64rem) 45vw, 100vw", { loading: "eager", fetchpriority: "high", class: "hero__img" } %}
      </div>
      <p class="hero__badge">{% icon "award", "hero__badge-icon" %}<span>{{ c.ui.since }}</span></p>
    </div>
  </div>
</section>
