{#- Testimonials (tint). Raffi (2026-10-29): « the most important piece », placed before the FAQ and form.
    Data: c.reviews { eyebrow, title, items[{ quote, name, role, sample? }] }, c.ui.sample.
    Until Pedlex supplies approved testimonials the items are SAMPLES (Josh, 2026-10-30): realistic,
    fictional people at generic companies (no real names, no figures or claims), each card tagged
    « Exemple ». Real quotes replace them one for one; drop `sample` then.
    Phones: a horizontal scroll-snap row (keeps the page short); from 48rem: three columns. The row is
    only a tab stop while it actually scrolls (scripts/sections/reviews.js).
    Styles: styles/sections/reviews.css -#}
{%- from "components/ui.njk" import sectionHead -%}
<section class="section section--tint reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    {{ sectionHead(c.reviews.eyebrow, c.reviews.title, null, { id: "reviews-title", align: "center", index: sectionIndex }) }}
    <ul class="reviews__list section-body" role="list" aria-label="{{ c.reviews.eyebrow | plain }}" data-reviews-row data-reveal-stagger>
      {%- for item in c.reviews.items %}
      {%- set initials = [] %}
      {%- for word in (item.name | plain).split(" ") %}{% if word %}{% set _ = initials.push(word | first | upper) %}{% endif %}{% endfor %}
      <li class="reviews__item">
        <figure class="reviews__card">
          <span class="reviews__mark" aria-hidden="true">«</span>
          <blockquote class="reviews__quote">
            <p>{{ item.quote | safe }}</p>
          </blockquote>
          <figcaption class="reviews__author">
            <span class="reviews__avatar" aria-hidden="true">{{ initials | join("") | truncate(2, true, "") }}</span>
            <span class="reviews__who"><span class="reviews__name">{{ item.name | safe }}</span><span class="reviews__role">{% if item.sample %}<span class="reviews__tag">{{ c.ui.sample }}</span> · {% endif %}{{ item.role | safe }}</span></span>
          </figcaption>
        </figure>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
