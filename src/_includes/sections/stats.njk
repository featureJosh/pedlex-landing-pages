{#- Stats: three key figures on the navy band. Styles: styles/sections/stats.css
    Data: c.stats.label (visually hidden h2), c.stats.items[]: { prefix?, from?, value?, suffix?, text?, label }.
    `from` makes a range (« 30 à 50 % »), joined by c.ui.rangeSep; both numbers count up.
    The FINAL value is in the HTML. scripts/sections/stats-counter.js counts [data-count-to] up from 0
    once, when the row enters the viewport. The animated figure is aria-hidden; screen readers get the
    real value from the visually-hidden copy next to it. -#}
<section class="section section--dark section--compact stats" id="stats" aria-labelledby="stats-title">
  <div class="container">
    <h2 class="visually-hidden" id="stats-title">{{ c.stats.label | safe }}</h2>
    <ul class="stats__list" role="list" data-stats>
      {%- for item in c.stats.items %}
      {#- A leading space in the suffix (" %", " ans") becomes a no-break space; none ("%") = attached. #}
      {%- set suffix = (item.suffix or "") | trim %}
      {%- set gap = "&nbsp;" if (item.suffix and item.suffix != suffix) else "" %}
      <li class="stats__item">
        <p class="stats__figure">
          {%- if item.prefix %}<span class="stats__prefix">{{ item.prefix | safe }}</span>{% endif %}
          {%- if item.value is defined %}
          <span class="stats__value" aria-hidden="true">
            {%- if item.from is defined %}<span class="stats__number" data-count-to="{{ item.from }}">{{ item.from | num(lang) }}</span><span class="stats__sep">{{ c.ui.rangeSep }}</span>{% endif -%}
            <span class="stats__number" data-count-to="{{ item.value }}">{{ item.value | num(lang) }}</span>{% if suffix %}{{ gap | safe }}<span class="stats__suffix">{{ suffix | safe }}</span>{% endif %}</span>
          <span class="visually-hidden">{% if item.from is defined %}{{ item.from | num(lang) }} {{ c.ui.rangeSep }} {% endif %}{{ item.value | num(lang) }}{% if suffix %}{{ gap | safe }}{{ suffix | safe }}{% endif %}</span>
          {%- else %}
          <span class="stats__value stats__value--text">{{ item.text | safe }}</span>
          {%- endif %}
        </p>
        <p class="stats__label">{{ item.label | safe }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
