{#- Trust bar: client logos under a one-line caption. Styles: styles/sections/trust.css
    Data: c.trust.title, c.trust.logos[]: { image, name } (alt = company name).
    Without JS (or with reduced motion) the logos sit in a static, centred, wrapping row.
    scripts/sections/trust-marquee.js turns [data-marquee] into a slow seamless loop by cloning the
    list (clones are aria-hidden, alt=""), then sets [data-marquee-ready] to start the CSS animation.
    No pause button (Josh, 2026-10-30): the loop pauses on hover and keyboard focus, and reduced
    motion keeps the static row. -#}
<section class="section section--compact trust" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <h2 class="trust__title" id="trust-title" data-reveal>{{ c.trust.title | safe }}</h2>
    <div class="trust__marquee" data-marquee data-reveal>
      <div class="trust__rail" data-marquee-rail>
        <ul class="trust__list" role="list" data-marquee-list>
          {%- for logo in c.trust.logos %}
          <li class="trust__logo">{% picture logo.image, logo.name, "200px", { class: "trust__img" } %}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
