{#- Process (dark, photo backdrop). Data: c.process { eyebrow, title, image, imageAlt, steps[{ title, text }], cta }.
    St-Amour-style 1-2-3 (Raffi, 2026-10-29): centred head, numbered steps side by side joined by a
    hairline, one centred CTA. The installer photo sits behind a strong navy scrim (decorative here, so
    alt=""; the steps carry the content). Phones: steps stack along a vertical rail.
    The step numbers are presentational (the <ol> conveys order), so they are aria-hidden.
    Styles: styles/sections/process.css -#}
{%- from "components/ui.njk" import sectionHead, ctaRow -%}
<section class="section section--dark process" id="process" aria-labelledby="process-title">
  <div class="process__backdrop" aria-hidden="true">
    {% picture c.process.image, "", "100vw", { class: "process__img" } %}
  </div>
  <div class="container">
    {{ sectionHead(c.process.eyebrow, c.process.title, null, { id: "process-title", align: "center", index: sectionIndex }) }}
    <ol class="process__steps section-body" role="list" data-reveal-stagger>
      {%- for step in c.process.steps %}
      <li class="process__step">
        <span class="process__num" aria-hidden="true">{{ loop.index }}</span>
        <div class="process__body">
          <h3 class="process__title">{{ step.title | safe }}</h3>
          <p class="process__text">{{ step.text | safe }}</p>
        </div>
      </li>
      {%- endfor %}
    </ol>
    {{ ctaRow(c, { label: c.process.cta, align: "center", variant: "on-dark" }) }}
  </div>
</section>
