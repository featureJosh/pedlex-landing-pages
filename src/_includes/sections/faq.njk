{#- FAQ. Native <details>/<summary> accordion (keyboard and screen-reader support built in, works
    without JS), all items closed. Sits right before the form (Raffi, 2026-10-29), so it has no
    closing CTA of its own any more. Data: c.faq.{eyebrow, title, items[{q, a}]}.
    Motion: open/close height eases via CSS ::details-content (styles/sections/faq.css); browsers
    without support simply open instantly. No JS. -#}
{%- from "components/ui.njk" import sectionHead -%}
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container container--narrow">
    {{ sectionHead(c.faq.eyebrow, c.faq.title, null, { id: "faq-title", align: "center", index: sectionIndex }) }}

    <div class="faq__list section-body" data-reveal>
      {%- for item in c.faq.items %}
      <details class="faq__item">
        <summary class="faq__question">
          <span class="faq__question-text">{{ item.q | safe }}</span>
          <span class="faq__toggle">{% icon "plus" %}</span>
        </summary>
        <div class="faq__answer">
          <p>{{ item.a | safe }}</p>
        </div>
      </details>
      {%- endfor %}
    </div>

  </div>
</section>
