{#- Campaign header: bigger logo + the one CTA. No navigation (brief §4.4); phone and FR/EN live in
    the top bar (partials/topbar.njk). Sticky. Over the dark hero it is transparent with the white
    logo; once the page scrolls ([data-scrolled], scripts/components/header.js) it turns white with
    the navy logo. Pages without the dark hero (thank-you) use the solid state from the start. -#}
{%- from "components/ui.njk" import button -%}
<header class="site-header{% if isThanks %} site-header--solid{% endif %}" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="{{ entry.url | url }}" aria-label="{{ c.ui.logoAlt | plain }}">
      {% picture "brand/pedlex-logo-white", "", "184px", { loading: "eager", class: "site-header__logo-img site-header__logo-img--light" } %}
      {% picture "brand/pedlex-logo", "", "184px", { loading: "eager", class: "site-header__logo-img site-header__logo-img--dark" } %}
    </a>
    {%- if not isThanks %}
    {{ button(c.ui.cta, "#" + c.form.id, { size: "sm", class: "site-header__cta", short: c.ui.ctaShort, icon: "arrow-right" }) }}
    {%- endif %}
  </div>
</header>
